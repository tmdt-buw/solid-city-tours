{
  "name": "@hoelk-f/city-tours",
  "version": "0.1.35",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "/city-tours",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3006",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:lib:watch": "vite build --config vite.lib.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:app && npm run build:lib",
    "test": "vitest run"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "./embed": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./embed.css": "./dist/embed.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@hoelk-f/semantic-data-catalog": "0.8.94",
    "@inrupt/oidc-client-ext": "5.0.3",
    "@inrupt/solid-client": "1.30.2",
    "@inrupt/solid-client-authn-browser": "5.0.3",
    "@inrupt/solid-client-authn-core": "5.0.3",
    "leaflet": "^1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.184.0"
  },
  "overrides": {
    "@inrupt/oidc-client-ext": "5.0.3",
    "@inrupt/solid-client-authn-core": "5.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  }
}
